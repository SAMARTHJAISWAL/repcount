{
  "name": "repcount",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only workout rep counter: on-device pose detection with MediaPipe, nothing leaves your device.",
  "license": "MIT",
  "author": "Samarth Jaiswal",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test && vite build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
